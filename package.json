{
  "name": "akshar-yatra",
  "private": true,
  "version": "0.5.0",
  "description": "Akshar Yatra (अक्षर यात्रा) — a Nepali alphabet and Nepal-discovery game for kids. Web first, Android via Capacitor.",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-emoji.mjs && node scripts/gen-map.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "test:e2e": "npm run build && playwright test"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@twemoji/svg": "^15.0.0",
    "@types/node": "26.6.6",
    "jsdom": "^31.0.1",
    "nepali-geo-pro-max": "^1.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
